# Copy to .env and fill in. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Leave blank locally to use SQLite. Production: the Neon connection string.
DATABASE_URL=

# Google login (Google Cloud console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI helper (optional; leave blank to turn the AI off and show tips/links instead)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_PLAN_MODEL=openai/gpt-oss-120b
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/meta/llama-3.1-8b-instruct
AI_DAILY_LIMIT=20
AI_INTAKE_DAILY_LIMIT=2
# Save AI-written plan outlines for review in admin (learners don't see them yet)
AI_OUTLINES=False
# Give learners AI-written plans and lessons instead of the curated plan
AI_PLANS=False
AI_LESSON_DAILY_LIMIT=12
# Seconds: one plan or lesson AI call, and all of a page's AI calls together (the server allows 60)
AI_PLAN_CALL_TIMEOUT=30
AI_REQUEST_BUDGET=50

# Reminder emails (optional; only needed to run send_reminders)
# Links in emails point at the live site. Set SITE_URL only to test emails locally.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
